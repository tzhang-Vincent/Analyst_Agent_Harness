# --- LLM provider selection -------------------------------------------------
# anthropic (default) | openai | deepseek
LLM_PROVIDER=anthropic

# Model id. Defaults to deepseek-v4-pro. Swap for any model your provider serves,
# e.g. claude-sonnet-5-5, gpt-4o, deepseek-chat, ...
LLM_MODEL=deepseek-v4-pro

# Optional: override the API base URL. DeepSeek exposes an Anthropic-compatible
# endpoint, so provider=anthropic can drive deepseek-v4-pro directly:
#   LLM_BASE_URL=https://api.deepseek.com/anthropic
# LLM_BASE_URL=

# --- API keys ---------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# --- SEC EDGAR ---------------------------------------------------------------
# SEC requires a descriptive User-Agent. Set this to a real contact address.
SEC_USER_AGENT=financial-research-agent/0.1 (your-email@example.com)
